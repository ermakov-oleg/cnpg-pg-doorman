# Build Go wrapper
FROM --platform=$BUILDPLATFORM golang:1.27@sha256:e432b43af23a9328d56a7c499be0476810aa344acbcf65fc7c455d4ff5a40602 AS go-builder
ARG TARGETOS
ARG TARGETARCH

WORKDIR /workspace
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath -o /doorman-wrapper ./cmd/wrapper/

# Final image: pg_doorman base + our wrapper
FROM ghcr.io/ozontech/pg_doorman:v3.11.0@sha256:b4c32c60e4267bbfe5ddd138c53a16e9f2e143fc64d7b3fae879b711d0db8578
COPY --from=go-builder /doorman-wrapper /usr/local/bin/doorman-wrapper
ENTRYPOINT ["/usr/local/bin/doorman-wrapper"]
